# URL de base du site pour les balises SEO (canonical, hreflang).
# En développement local :
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# En production (Vercel) :
# Obligatoire si VERCEL_ENV=production. Doit impérativement commencer par https:// et ne pas comporter de slash final.
# Exemple : NEXT_PUBLIC_SITE_URL=https://easyjev.com
